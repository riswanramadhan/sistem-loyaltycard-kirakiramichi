NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://kirakiraloyaltycard.web.id

# Server-only. Prefer the modern Supabase secret key. Add only one of these in
# Vercel/server environments and never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-sb-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

# Required only while running `npm run admin:bootstrap`.
BOOTSTRAP_ADMIN_EMAIL=kirakiramichi@dekatlokal.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-secret
